{
  "name": "pannel-handle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Windows terminal session manager",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6173 --strictPort",
    "dev:browser": "vite --mode browser-preview --host 127.0.0.1 --port 6174 --strictPort",
    "dev:mobile": "pnpm --filter pannel-handle-mobile dev",
    "electron": "electron .",
    "prestart": "pnpm build:mobile",
    "start": "concurrently -k \"pnpm dev\" \"wait-on http://127.0.0.1:6173 && electron .\"",
    "test": "pnpm test:desktop && pnpm test:mobile",
    "test:desktop": "vitest run --exclude mobile/**",
    "test:mobile": "pnpm --filter pannel-handle-mobile test",
    "build": "pnpm build:desktop && pnpm build:mobile",
    "build:desktop": "tsc && vite build",
    "build:mobile": "pnpm --filter pannel-handle-mobile build",
    "mobile:check": "node scripts/validate-mobile-build.cjs",
    "idea:plugin:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-idea-plugin.ps1",
    "dist:dir": "node scripts/patch-electron-builder-rcedit.cjs && pnpm build && pnpm mobile:check && electron-builder --dir",
    "dist:portable": "node scripts/patch-electron-builder-rcedit.cjs && pnpm build && pnpm mobile:check && electron-builder"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "1.2.3",
    "@qoder-ai/qoder-agent-sdk": "1.0.25",
    "@vitejs/plugin-react": "^4.5.0",
    "@vscode/ripgrep": "^1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "5.3.2",
    "bonjour-service": "1.3.0",
    "chokidar": "^5.0.0",
    "docx-preview": "0.4.0",
    "exceljs": "4.4.0",
    "highlight.js": "^11.11.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.0.0",
    "pg": "^8.23.0",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.8.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "util-deprecate": "1.0.2",
    "vite": "^6.0.0",
    "ws": "8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.15.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.pannel-handle",
    "productName": "Pannel Handle",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@vscode/ripgrep-win32-*/bin/**",
      "electron/services/codex-model-bridge/codebuddy-preload.cjs"
    ],
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mobile/dist",
        "to": "mobile",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
